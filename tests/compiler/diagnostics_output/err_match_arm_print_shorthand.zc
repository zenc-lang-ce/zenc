// ARGS: build
// A string after `println` on the line of a match arm is reported there, not read as the pattern of the next arm.
import "std/io.zc"

fn foo(_s: string) -> int { return 1; }

fn main() {
    let n = 1;
    match n {
        1 => println "one",
        _ => 0
    }
    println(f"{foo(\"x\")}");
}
