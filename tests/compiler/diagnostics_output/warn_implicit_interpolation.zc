// ARGS: build
// A plain "..." with a `{expr}` warns that implicit interpolation is deprecated
// (RFC 0001), wherever it interpolates: a value, println, a bare string, `!`, `?`
// and an assert message. f"...", r"...", escaped braces and text without braces do
// not warn.

fn main() {
    let x = 1;
    let n = 0;
    let s = "value {x}";
    println "println {x}";
    "bare {x}";
    !"stderr {x}";
    let got = ? "prompt {x}: " (n);
    assert(x == 1, "assert {x}");
    let t = f"f-string {x}";
    println r"raw {x}";
    println "escaped {{x}}";
    println "no braces";
    printf("%s %s %d\n", s, t, got);
}
