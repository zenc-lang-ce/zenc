// ARGS: run -q
// `return &self;` returns the receiver, with a defer pending or not (the warning is in
// return_address_of_self).
import "std/io.zc"

let hits = 0;

struct Counter {
    n: int;
}

impl Counter {
    fn get(self) -> Counter* {
        return &self;
    }

    fn get_with_defer(self) -> Counter* {
        defer hits = hits + 1;
        return &self;
    }
}

fn main() {
    let c = Counter { n: 1 };
    let p = c.get();
    let q = c.get_with_defer();
    println(f"{p == &c} {q == &c} {hits}");
}
