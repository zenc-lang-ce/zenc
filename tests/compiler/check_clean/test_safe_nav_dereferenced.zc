// compiler/check_clean: `zc check` must accept this file with no errors.
// `?.` on a pointer to a pointer is reported; dereferenced first, `(*pp)?.value` tests the
// pointer `pp` points to, and `?.` on a `P*` is accepted as before.
struct P { value: int; }

fn main() {
    let b = P { value: 3 };
    let p = &b;
    let pp = &p;
    let none: P* = NULL;
    let pnone = &none;
    puts(f"{(*pp)?.value} {(*pnone)?.value} {p?.value}");
}
