// stdlib/serialization: derives on records with many fields
import "std/json.zc"

@derive(FromJson, ToJson, Eq, Clone)
struct SensorReadings {
    additional_sensor_value_00: int;
    additional_sensor_value_01: int;
    additional_sensor_value_02: int;
    additional_sensor_value_03: int;
    additional_sensor_value_04: int;
    additional_sensor_value_05: int;
    additional_sensor_value_06: int;
    additional_sensor_value_07: int;
    additional_sensor_value_08: int;
    additional_sensor_value_09: int;
    additional_sensor_value_10: int;
    additional_sensor_value_11: int;
    additional_sensor_value_12: int;
    additional_sensor_value_13: int;
    additional_sensor_value_14: int;
    additional_sensor_value_15: int;
    additional_sensor_value_16: int;
    additional_sensor_value_17: int;
    additional_sensor_value_18: int;
    additional_sensor_value_19: int;
    additional_sensor_value_20: int;
    additional_sensor_value_21: int;
    additional_sensor_value_22: int;
    additional_sensor_value_23: int;
    additional_sensor_value_24: int;
    additional_sensor_value_25: int;
    additional_sensor_value_26: int;
    additional_sensor_value_27: int;
    additional_sensor_value_28: int;
    additional_sensor_value_29: int;
    additional_sensor_value_30: int;
    additional_sensor_value_31: int;
    additional_sensor_value_32: int;
    additional_sensor_value_33: int;
    additional_sensor_value_34: int;
    additional_sensor_value_35: int;
    additional_sensor_value_36: int;
    additional_sensor_value_37: int;
    additional_sensor_value_38: int;
    additional_sensor_value_39: int;
    additional_sensor_value_40: int;
    additional_sensor_value_41: int;
    additional_sensor_value_42: int;
    additional_sensor_value_43: int;
    additional_sensor_value_44: int;
    additional_sensor_value_45: int;
    additional_sensor_value_46: int;
    additional_sensor_value_47: int;
    additional_sensor_value_48: int;
    additional_sensor_value_49: int;
    additional_sensor_value_50: int;
    additional_sensor_value_51: int;
    additional_sensor_value_52: int;
    additional_sensor_value_53: int;
    additional_sensor_value_54: int;
    additional_sensor_value_55: int;
