    additional_sensor_value_66: int;
    additional_sensor_value_67: int;
    additional_sensor_value_68: int;
    additional_sensor_value_69: int;
    additional_sensor_value_70: int;
    additional_sensor_value_71: int;
    additional_sensor_value_72: int;
    additional_sensor_value_73: int;
    additional_sensor_value_74: int;
    additional_sensor_value_75: int;
    additional_sensor_value_76: int;
    additional_sensor_value_77: int;
