// stdlib/collections: test_readln_scan
import "std/io.zc"
test "test_readln_scan" {
    println("Testing readln compilation...");
    
    let x: int = 0;
    let f: float = 0.0;
    
    if (1 == 0) {
        let s = readln();
        
        let count = readln(x);  
        readln(f);
        
        readln(x, f);
        
    }
    
    println("Smart readln compiled successfully");
}
