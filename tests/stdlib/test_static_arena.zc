// test_static_arena: StaticArena::realloc copies only what fits in the new block
import "std.zc"

// An arena over a local buffer, with 32 guard bytes after its capacity.
let _guarded: [byte; 128];

fn guarded_arena() -> StaticArena {
    for (let i: usize = 0; i < 128; i = i + 1) {
        _guarded[i] = (byte)0xEE;
    }
    return StaticArena { data: (byte*)&_guarded, capacity: 96, used: 0 };
}

fn guard_intact() -> bool {
    for (let i: usize = 96; i < 128; i = i + 1) {
        if (_guarded[i] != (byte)0xEE) {
            return false;
        }
    }
    return true;
}

test "realloc shrinks a block that is not the last allocation" {
    let a = guarded_arena();
    let p = a.alloc_n<byte>(64);
    for (let i: usize = 0; i < 64; i = i + 1) {
        p[i] = (byte)i;
    }
    let _tip = a.alloc_n<byte>(8);

    let q = a.realloc<byte>(p, 64, 16);

    assert(guard_intact(), "realloc to a smaller size should not write past the block");
    assert(q == p, "realloc to a smaller size should keep a block that is not the last where it is");
    assert(a.used == 72, "realloc to a smaller size should not allocate when the block is not the last");
    for (let i: usize = 0; i < 16; i = i + 1) {
        assert(q[i] == (byte)i, "realloc to a smaller size should keep the first new_count items");
    }
}

test "realloc shrinks the last allocation in place" {
    let a = guarded_arena();
    let p = a.alloc_n<byte>(64);
    for (let i: usize = 0; i < 64; i = i + 1) {
        p[i] = (byte)i;
    }

    let q = a.realloc<byte>(p, 64, 16);

    assert(q == p, "realloc of the last allocation should keep it where it is");
    assert(a.used == 16, "realloc of the last allocation to a smaller size should give back the rest");
    for (let i: usize = 0; i < 16; i = i + 1) {
        assert(q[i] == (byte)i, "realloc of the last allocation should keep the first new_count items");
    }
}

test "realloc grows a block that is not the last allocation" {
    let a = guarded_arena();
    let p = a.alloc_n<byte>(16);
    for (let i: usize = 0; i < 16; i = i + 1) {
        p[i] = (byte)(i + 1);
    }
    let _tip = a.alloc_n<byte>(8);

    let q = a.realloc<byte>(p, 16, 32);

    assert(guard_intact(), "realloc to a larger size should not write past the arena");
    for (let i: usize = 0; i < 16; i = i + 1) {
        assert(q[i] == (byte)(i + 1), "realloc to a larger size should keep the old items");
    }
}

// An arena that owns _outer[64..256], with memory below it that is not part of it.
let _outer: [byte; 256];

fn grow_from_below(distance: usize) {
    let a = StaticArena { data: (byte*)&_outer[64], capacity: 192, used: 0 };
    let outside = (byte*)&_outer[64 - distance];
    for (let i: usize = 0; i < distance; i = i + 1) {
        outside[i] = (byte)(i + 1);
    }

    let q = a.realloc<byte>(outside, distance, 64);

    assert(q != outside, "realloc should not take memory below the arena for its last allocation");
    assert(q == (byte*)&_outer[64], "realloc of memory outside the arena should allocate in the arena");
    assert(a.used == 64, "realloc of memory outside the arena should use new_count bytes of it");
    for (let i: usize = 0; i < distance; i = i + 1) {
        assert(q[i] == (byte)(i + 1), "realloc of memory outside the arena should copy its old items");
    }
}

test "realloc of memory just below the arena does not grow it in place" {
    grow_from_below(8);
    grow_from_below(56);
}
