// An enum the program uses is not an unused type (Rule 2.4): as the type of a
// variable, a parameter or a return value, through its variants only, with
// @link_name, and as a generic enum used through an instance.
// EXPECT: PASS

enum Mode { On, Off }

enum Level { Low, High }

enum Shape { Dot, Square(int) }

@link_name("c_tone")
enum Tone { Soft, Loud }

enum Maybe<T> { Nothing, Just(T) }

fn is_on(m: Mode) -> bool {
    return m == Mode::On;
}

fn loud() -> Tone {
    return Tone::Loud;
}

fn main() -> int {
    let code: int = 1;
    let current: Mode = Mode::On;
    let on: bool = is_on(current);
    let sound: Tone = loud();
    let is_loud: bool = sound == Tone::Loud;
    let level: int = (int)Level::Low;
    let square = Shape::Square(level);
    let wrapped = Maybe<int>::Just(level);
    let sizes: usize = sizeof(square) + sizeof(wrapped);
    if on && is_loud && sizes > 0u {
        code = level;
    }
    return code;
}
