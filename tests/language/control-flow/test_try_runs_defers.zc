// control-flow: the early return of `?` leaves the function as a `return` does: the pending
// defers run, the drops of the locals and parameters among them.

import "std/result.zc"
import "std/option.zc"

let trail = 0;

struct Guard {
    id: int;
}

impl Drop for Guard {
    fn drop(self) {
        trail = trail + self.id;
    }
}

enum Outcome {
    Ok(int),
    Err(int),
}

fn res_of(ok: bool) -> Result<int> {
    if ok {
        return Result<int>::Ok(2);
    }
    return Result<int>::Err("fail");
}

fn text_of(ok: bool) -> Result<string> {
    if ok {
        return Result<string>::Ok("abc");
    }
    return Result<string>::Err("no text");
}

fn opt_of(ok: bool) -> Option<int> {
    if ok {
        return Option<int>::Some(3);
    }
    return Option<int>::None();
}

fn outcome_of(ok: bool) -> Outcome {
    if ok {
        return Outcome::Ok(4);
    }
    return Outcome::Err(9);
}

fn with_defer_and_local(ok: bool) -> Result<int> {
    defer trail = trail + 1;
    let g = Guard { id: 10 };
    let v = res_of(ok)?;
    return Result<int>::Ok(v + g.id);
}

fn in_inner_block(ok: bool) -> Option<int> {
    defer trail = trail + 100;
    {
        defer trail = trail + 1000;
        let v = opt_of(ok)?;
        return Option<int>::Some(v);
    }
}

fn with_drop_parameter(g: Guard, ok: bool) -> Outcome {
    let v = outcome_of(ok)?;
    return Outcome::Ok(v + g.id);
}

fn inside_expression(ok: bool) -> Result<int> {
    defer trail = trail + 7;
    return Result<int>::Ok(res_of(ok)? + 1);
}

fn inside_loop(ok: bool) -> Result<int> {
    defer trail = trail + 1;
    let total = 0;
    for i in 0..3 {
        defer trail = trail + 10;
        let fine = ok || i < 1;
        total = total + res_of(fine)?;
    }
    return Result<int>::Ok(total);
}

fn other_result_type(ok: bool) -> Result<int> {
    defer trail = trail + 5;
    let s = text_of(ok)?;
    return Result<int>::Ok((int)strlen(s));
}

test "a defer and the drop of a local run when ? returns early" {
    trail = 0;
    assert(with_defer_and_local(false).is_err(), "the error is returned");
    assert(trail == 11, "the defer and the drop ran once each");
    trail = 0;
    let r = with_defer_and_local(true);
    assert(r.is_ok() && r.val == 12, "the value goes on");
    assert(trail == 11, "on success they run once, at the end");
}

test "the defers of the enclosing blocks run, innermost first" {
    trail = 0;
    assert(in_inner_block(false).is_none(), "None is returned");
    assert(trail == 1100, "the defers of both blocks ran");
}

test "the drop of a parameter runs when ? returns early" {
    trail = 0;
    let err = 0;
    match with_drop_parameter(Guard { id: 20 }, false) {
        Outcome::Ok(_v) => { err = -1; },
        Outcome::Err(e) => { err = e; },
    }
    assert(err == 9, "the error is returned");
    assert(trail == 20, "the parameter was dropped");
}

test "? inside an expression" {
    trail = 0;
    assert(inside_expression(false).is_err(), "the error is returned");
    assert(trail == 7, "the defer ran");
    trail = 0;
    assert(inside_expression(true).val == 3, "the value goes on");
    assert(trail == 7, "the defer ran once");
}

test "? inside a loop runs the loop body's defers and the function's" {
    trail = 0;
    assert(inside_loop(false).is_err(), "the error is returned");
    assert(trail == 21, "the first iteration's defer, the second's, and the function's");
    trail = 0;
    assert(inside_loop(true).val == 6, "the value goes on");
    assert(trail == 31, "three iterations' defers and the function's");
}

test "? on a Result of another type" {
    trail = 0;
    assert(other_result_type(false).is_err(), "the error is returned");
    assert(trail == 5, "the defer ran");
}
