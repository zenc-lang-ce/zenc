// language/control-flow: the bounds and the step of a `for` range read the variable the loop
// variable shadows, in C too, where the loop variable is in scope in its own `for` header.

// Every loop stops after 20 iterations, so a range that reads the loop variable does not hang.
let LIMIT = 20;

test "an end that names the loop variable reads the shadowed variable" {
    let i = 3;
    let count = 0;
    let sum = 0;
    for i in 0..i {
        count = count + 1;
        sum = sum + i;
        if count == LIMIT { break; }
    }
    expect_eq(count, 3, "0..i should run 3 times when the shadowed i is 3");
    expect_eq(sum, 3, "0..i should visit 0, 1 and 2");
    expect_eq(i, 3, "the shadowed i should be unchanged");
}

test "an inclusive end that names the loop variable reads the shadowed variable" {
    let i = 3;
    let count = 0;
    for i in 0..=i {
        count = count + 1;
        if count == LIMIT { break; }
    }
    expect_eq(count, 4, "0..=i should run 4 times when the shadowed i is 3");
}

test "a start that names the loop variable reads the shadowed variable" {
    let i = 3;
    let count = 0;
    let first = -1;
    for i in i..6 {
        if count == 0 { first = i; }
        count = count + 1;
        if count == LIMIT { break; }
    }
    expect_eq(first, 3, "i..6 should start at the shadowed i");
    expect_eq(count, 3, "i..6 should run 3 times when the shadowed i is 3");
}

test "a start and an end that name the loop variable read the shadowed variable" {
    let i = 3;
    let count = 0;
    let sum = 0;
    for i in i..i + 2 {
        count = count + 1;
        sum = sum + i;
        if count == LIMIT { break; }
    }
    expect_eq(count, 2, "i..i + 2 should run 2 times");
    expect_eq(sum, 7, "i..i + 2 should visit 3 and 4");
}

test "a step that names the loop variable reads the shadowed variable" {
    let i = 2;
    let count = 0;
    let sum = 0;
    for i in 0..9 step i {
        count = count + 1;
        sum = sum + i;
        if count == LIMIT { break; }
    }
    expect_eq(count, 5, "0..9 step i should run 5 times when the shadowed i is 2");
    expect_eq(sum, 20, "0..9 step i should visit 0, 2, 4, 6 and 8");
}

test "a descending range that names the loop variable reads the shadowed variable" {
    let i = 3;
    let count = 0;
    let sum = 0;
    for i in i..0 step -1 {
        count = count + 1;
        sum = sum + i;
        if count == LIMIT { break; }
    }
    expect_eq(count, 3, "i..0 step -1 should run 3 times when the shadowed i is 3");
    expect_eq(sum, 6, "i..0 step -1 should visit 3, 2 and 1");
}

test "a labeled range that names the loop variable reads the shadowed variable" {
    let i = 3;
    let count = 0;
    outer: for i in 0..i {
        for j in 0..2 {
            if i == 1 && j == 1 { continue outer; }
            count = count + 1;
            if count == LIMIT { break outer; }
        }
    }
    expect_eq(count, 5, "the outer loop should run 3 times and skip one inner step");
}
