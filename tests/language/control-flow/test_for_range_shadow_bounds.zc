// language/control-flow: the bounds and the step of a `for` range read the variable the loop
// variable shadows, in C too, where the loop variable is in scope in its own `for` header.

// Every loop stops after 20 iterations, so a range that reads the loop variable does not hang.
let LIMIT = 20;

test "an end that names the loop variable reads the shadowed variable" {
    let i = 3;
    let count = 0;
    let sum = 0;
    for i in 0..i {
        count = count + 1;
        sum = sum + i;
        if count == LIMIT { break; }
    }
    expect_eq(count, 3, "0..i should run 3 times when the shadowed i is 3");
    expect_eq(sum, 3, "0..i should visit 0, 1 and 2");
    expect_eq(i, 3, "the shadowed i should be unchanged");
}

test "an inclusive end that names the loop variable reads the shadowed variable" {
    let i = 3;
    let count = 0;
    for i in 0..=i {
        count = count + 1;
        if count == LIMIT { break; }
    }
    expect_eq(count, 4, "0..=i should run 4 times when the shadowed i is 3");
}

test "a start that names the loop variable reads the shadowed variable" {
    let i = 3;
    let count = 0;
    let first = -1;
    for i in i..6 {
        if count == 0 { first = i; }
        count = count + 1;
        if count == LIMIT { break; }
    }
    expect_eq(first, 3, "i..6 should start at the shadowed i");
    expect_eq(count, 3, "i..6 should run 3 times when the shadowed i is 3");
}

test "a start and an end that name the loop variable read the shadowed variable" {
    let i = 3;
    let count = 0;
    let sum = 0;
    for i in i..i + 2 {
        count = count + 1;
        sum = sum + i;
        if count == LIMIT { break; }
    }
    expect_eq(count, 2, "i..i + 2 should run 2 times");
    expect_eq(sum, 7, "i..i + 2 should visit 3 and 4");
}

test "a step that names the loop variable reads the shadowed variable" {
    let i = 2;
    let count = 0;
    let sum = 0;
    for i in 0..9 step i {
        count = count + 1;
        sum = sum + i;
        if count == LIMIT { break; }
    }
    expect_eq(count, 5, "0..9 step i should run 5 times when the shadowed i is 2");
    expect_eq(sum, 20, "0..9 step i should visit 0, 2, 4, 6 and 8");
}

test "a descending range that names the loop variable reads the shadowed variable" {
    let i = 3;
    let count = 0;
    let sum = 0;
    for i in i..0 step -1 {
        count = count + 1;
        sum = sum + i;
        if count == LIMIT { break; }
    }
    expect_eq(count, 3, "i..0 step -1 should run 3 times when the shadowed i is 3");
    expect_eq(sum, 6, "i..0 step -1 should visit 3, 2 and 1");
}

test "a labeled range that names the loop variable reads the shadowed variable" {
    let i = 3;
    let count = 0;
    outer: for i in 0..i {
        for j in 0..2 {
            if i == 1 && j == 1 { continue outer; }
            count = count + 1;
            if count == LIMIT { break outer; }
        }
    }
    expect_eq(count, 5, "the outer loop should run 3 times and skip one inner step");
}

test "a negated step that names the loop variable reads the shadowed variable" {
    let i = 2;
    let count = 0;
    let sum = 0;
    for i in 9..0 step -i {
        count = count + 1;
        sum = sum + i;
        if count == LIMIT { break; }
    }
    expect_eq(count, 5, "9..0 step -i should run 5 times when the shadowed i is 2");
    expect_eq(sum, 25, "9..0 step -i should visit 9, 7, 5, 3 and 1");
}

test "a bound that names the loop variable has the type it has without the shadow" {
    let i: u8 = 250;
    let shadowed = 0;
    for i in 0..i + 10 {
        shadowed = shadowed + 1;
        if shadowed == 1000 { break; }
    }
    let k: u8 = 250;
    let plain = 0;
    for j in 0..k + 10 {
        plain = plain + 1;
        if plain == 1000 { break; }
    }
    expect_eq(plain, 260, "0..k + 10 should run 260 times when k is a u8 of 250");
    expect_eq(shadowed, plain, "0..i + 10 should run as many times as the same range without the shadow");
}

let calls = 0;

fn logged(v: int) -> int {
    calls = calls * 10 + v;
    return v;
}

test "bounds that name the loop variable are evaluated as any others" {
    let n = 3;
    calls = 0;
    for m in logged(1)..logged(n) {
        if m > LIMIT { break; }
    }
    expect_eq(calls, 1333, "logged(1)..logged(n) should evaluate the start once, then the end before each of its 3 checks");
    calls = 0;
    for n in logged(1)..logged(n) {
        if n > LIMIT { break; }
    }
    expect_eq(calls, 1333, "an end that names the loop variable should be evaluated as any other end");
}

fn three() -> int {
    return 3;
}

test "an end that calls a function named as the loop variable calls the function" {
    let count = 0;
    for three in 0..three() {
        count = count + 1;
        if count == LIMIT { break; }
    }
    expect_eq(count, 3, "0..three() should run 3 times");
}

test "an end that indexes an array named as the loop variable reads the array" {
    let i = [1, 2, 4];
    let count = 0;
    for i in 0..i[2] {
        count = count + 1;
        if count == LIMIT { break; }
    }
    expect_eq(count, 4, "0..i[2] should run 4 times when the shadowed i[2] is 4");
}

enum Boxed {
    Num(int),
    Nothing
}

test "a match binding named as the loop variable in a bound reads the binding" {
    let i = 10;
    let o = Boxed::Num(3);
    let count = 0;
    for i in 0..match o { Boxed::Num(i) => i, _ => 0 } {
        count = count + 1;
        if count == LIMIT { break; }
    }
    expect_eq(count, 3, "the binding i of the arm should be 3, not the shadowed 10");
    count = 0;
    for i in 0..match o { Boxed::Num(i) => (fn() -> int { return i; })(), _ => 0 } {
        count = count + 1;
        if count == LIMIT { break; }
    }
    expect_eq(count, 3, "a lambda in the arm should capture the binding i, not the shadowed 10");
}
