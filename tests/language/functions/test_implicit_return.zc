// functions: test_implicit_return
import "std/io.zc"
test "test_implicit_return" {
    // Adds newline
    println("Hello Implicit"); 

    // Adds newline
    println("Hello Explicit");

    // No newline
    print("Loading");
    print(".");
    print(".");
    println(" Done!");
    
    // With variables
    let x = 42;
    print("Value is: ");
    println(f"{x}");
}
