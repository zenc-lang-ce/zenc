// safety: test_lifetime_elision
// A function or method that returns a pointer it was given (or one into self)
// returns it with the lifetime of what it was given, so the caller can keep it
// in the same scope. Letting it escape that scope is an error:
// tests/compiler/diagnostics_output/err_escape_analysis.zc.
fn identity(p: int*) -> int* {
    return p;
}

struct S {
    x: int
}

impl S {
    fn get_x_ptr(self) -> int* {
        return &self.x;
    }
}

test "Function Lifetime Elision" {
    let x = 10;
    let p = identity(&x);
    assert(*p == 10, "identity(&x) should return a pointer usable in the scope of x");
}

test "Method Lifetime Elision" {
    let s = S { x: 42 };
    let p = s.get_x_ptr();
    assert(*p == 42, "s.get_x_ptr() should return a pointer usable in the scope of s");
}
