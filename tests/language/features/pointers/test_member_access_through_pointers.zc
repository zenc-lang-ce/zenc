// language/features/pointers: `.` reaches a field or a method through every level
// of pointer, as `.` on a `P*` does. With `pp: P**`, `pp.value` used to emit
// `pp->value`, which is not C, and `pp.get()` passed the `P**` as the `P*` self.
// In a generic, the extra level can come from the type parameter: `x: T*` with
// `T = P*`.

struct Inner {
    n: int;
}

struct P {
    value: int;
    inner: Inner;
}

impl P {
    fn get(self) -> int {
        return self.value;
    }

    fn bump(self) {
        self.value = self.value + 1;
    }
}

alias PRef = P*;

struct Holder<T> {
    item: T;
}

impl Holder<T> {
    fn peek(self) -> T {
        return self.item;
    }
}

fn value_of(pp: P**) -> int {
    return pp.value;
}

struct Ref<T> {
    ptr: T*;
}

impl Ref<T> {
    fn read(self) -> int {
        return self.ptr.value;
    }
}

fn field_through<T>(x: T*) -> int {
    return x.value;
}

fn method_through<T>(x: T*) -> int {
    return x.get();
}

test "fields through a pointer to a pointer" {
    // Arrange
    let b = P { value: 7, inner: Inner { n: 4 } };
    let p = &b;
    let pp = &p;
    let ppp = &pp;

    // Act
    pp.value = 9;
    ppp.inner.n = 5;

    // Assert
    expect_eq((*pp).value, 9, "(*pp).value should read the field");
    expect_eq(pp.value, 9, "pp.value should read the field written through pp");
    expect_eq(ppp.value, 9, "ppp.value should read the field through three pointers");
    expect_eq(value_of(pp), 9, "pp.value should read the field of a P** parameter");
    expect_eq(b.inner.n, 5, "ppp.inner.n should write the nested field of b");
    expect_eq(pp.inner.n, 5, "pp.inner.n should read the nested field");
}

test "methods through a pointer to a pointer" {
    // Arrange
    let b = P { value: 0, inner: Inner { n: 0 } };
    let p = &b;
    let pp = &p;
    let ppp = &pp;
    let h = Holder<int> { item: 3 };
    let hp = &h;
    let hpp = &hp;

    // Act
    pp.bump();
    ppp.bump();

    // Assert
    expect_eq(b.value, 2, "pp.bump() and ppp.bump() should each change b");
    expect_eq(pp.get(), 2, "pp.get() should pass *pp as self");
    expect_eq(ppp.get(), 2, "ppp.get() should pass **ppp as self");
    expect_eq(hpp.peek(), 3, "a method of a generic struct should take *hpp as self");
}

test "an alias of a pointer and an f-string" {
    // Arrange
    let b = P { value: 6, inner: Inner { n: 0 } };
    let p: PRef = &b;
    let pp = &p;

    // Act
    let s = f"{pp.value}|{pp.get()}";

    // Assert
    expect_eq(pp.value, 6, "pp.value should read the field through an alias of P*");
    expect_eq(pp.get(), 6, "pp.get() should take *pp as self through an alias of P*");
    expect(strcmp(s, "6|6") == 0, "an f-string should read the field and call the method");
}

test "a pointer level that comes from a type parameter" {
    // Arrange
    let b = P { value: 8, inner: Inner { n: 0 } };
    let p = &b;
    let pp = &p;
    let r = Ref<P*> { ptr: pp };

    // Act
    let field = field_through<P*>(pp);
    let method = method_through<P*>(pp);

    // Assert
    expect_eq(field, 8, "x.value should read the field when x is a T* with T = P*");
    expect_eq(method, 8, "x.get() should take *x as self when x is a T* with T = P*");
    expect_eq(r.ptr.value, 8, "a T* field with T = P* should reach the field");
    expect_eq(r.ptr.get(), 8, "a T* field with T = P* should reach the method");
    expect_eq(r.read(), 8, "a method of Ref<P*> should reach the field through self.ptr");
}
