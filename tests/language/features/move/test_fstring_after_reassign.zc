// features/move: interpolating values that are not moved, or that were
// assigned again after a move, still compiles.

import "std/io.zc"
import "std/string.zc"

test "interpolation of valid values" {
    let s1 = String::new("abc")
    let s2 = s1
    s1 = String::new("again")
    let text = f"{s1.c_str()} {s2.c_str()}"
    assert(strcmp(text, "again abc") == 0, "interpolated values")
    println(f"{s1.c_str()} {s2.length()}")
}
