// language/features/functions: functions: test_purity
// A @pure function may call another @pure function. Calling one that is not
// @pure is an error: tests/compiler/diagnostics_output/pure_calls_impure.zc.
@pure
fn another_pure_func() {
}

@pure
fn pure_calling_pure() {
    another_pure_func();
}

test "pure_enforcement" {
    pure_calling_pure();
}
