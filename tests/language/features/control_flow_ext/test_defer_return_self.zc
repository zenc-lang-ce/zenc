// language/features/control_flow_ext: `return &self` returns the pointer `self` is, whether a
// defer is pending or not.

let hits = 0;

struct Counter {
    n: int;
}

impl Counter {
    fn bump(self) -> Counter* {
        self.n = self.n + 1;
        return &self;
    }

    fn bump_with_defer(self) -> Counter* {
        defer hits = hits + 1;
        self.n = self.n + 1;
        return &self;
    }
}

test "return &self with a pending defer" {
    hits = 0;
    let c = Counter { n: 1 };
    let p = c.bump_with_defer();
    assert(p == &c, "return &self should return self when a defer is pending");
    assert(p.n == 2, "the method should change the receiver");
    assert(hits == 1, "the defer should run once");
}

test "return &self without a defer" {
    let c = Counter { n: 1 };
    let p = c.bump();
    assert(p == &c, "return &self should return self");
}
