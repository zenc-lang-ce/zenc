//> cflags: -masm=intel

import "std/io.zc"
fn add_five_intel(x: int) -> int {
    let result: int;
    asm {
        "mov {result}, {x}"
        "add {result}, 5"
        : out(result)
        : in(x)
    }
    return result;
}

test "test_intel" {
    let val = add_five_intel(10);
    println(f"Sum Intel: 10 + 5 = {val}");

    match val {
        15 => printf("-> Success!\n")
        _  => printf(f"-> Failed: expected 15, got {val}\n")
    }   
}
