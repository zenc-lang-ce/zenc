// structs: test_mixin_many
// A struct that mixes in more structs with `use` than the parser first makes room for (8).
import "std/io.zc"

struct Part0 {
    p0: int;
}

struct Part1 {
    p1: int;
}

struct Part2 {
    p2: int;
}

struct Part3 {
    p3: int;
}

struct Part4 {
    p4: int;
}

struct Part5 {
    p5: int;
}

struct Part6 {
    p6: int;
}

struct Part7 {
    p7: int;
}

struct Part8 {
    p8: int;
}

struct Part9 {
    p9: int;
}

struct Part10 {
    p10: int;
}

struct Part11 {
    p11: int;
}

struct Part12 {
    p12: int;
}

struct Part13 {
    p13: int;
}

struct Part14 {
    p14: int;
}

struct Part15 {
    p15: int;
}

struct Part16 {
    p16: int;
}

struct Part17 {
    p17: int;
}

struct Part18 {
    p18: int;
}

struct Part19 {
    p19: int;
}

struct All {
    use Part0;
    use Part1;
    use Part2;
    use Part3;
    use Part4;
    use Part5;
    use Part6;
    use Part7;
    use Part8;
    use Part9;
    use Part10;
    use Part11;
    use Part12;
    use Part13;
    use Part14;
    use Part15;
    use Part16;
    use Part17;
    use Part18;
    use Part19;
}

test "test_mixin_many" {
    let a = All {
        p0: 0, p1: 1, p2: 2, p3: 3, p4: 4, p5: 5, p6: 6, p7: 7,
        p8: 8, p9: 9, p10: 10, p11: 11, p12: 12, p13: 13, p14: 14, p15: 15,
        p16: 16, p17: 17, p18: 18, p19: 19
    };
    assert(a.p0 == 0 && a.p8 == 8 && a.p19 == 19, "every mixed-in field is there");
}
