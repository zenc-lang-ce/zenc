// arrays/slices: `a[i..j]` is a slice of part of an array or a slice, pointing into it.
struct Holder {
    items: int[5];
}

fn total(xs: [int]) -> int {
    let t = 0;
    for x in xs {
        t = t + x;
    }
    return t;
}

test "slicing an array" {
    let a: int[5] = [1, 2, 3, 4, 5];
    let mid = a[1..3];
    assert(mid.len == 2 && mid[0] == 2 && mid[1] == 3, "a[1..3]");
    let head = a[..2];
    assert(head.len == 2 && total(head) == 3, "a[..2]");
    let tail = a[3..];
    assert(tail.len == 2 && tail[0] == 4, "a[3..]");
    let all = a[..];
    assert(all.len == 5, "a[..]");
}

test "a slice points into the array" {
    let a: int[3] = [1, 2, 3];
    let s = a[1..];
    s[0] = 20;
    assert(a[1] == 20, "writing through the slice changes the array");
}

test "slicing a slice and a field" {
    let a: int[5] = [1, 2, 3, 4, 5];
    let all = a[..];
    let inner = all[1..4];
    assert(inner.len == 3 && inner[0] == 2 && inner[2] == 4, "a slice of a slice");

    let h: Holder;
    h.items[0] = 9;
    h.items[1] = 8;
    let first = h.items[..2];
    assert(first.len == 2 && first[1] == 8, "a slice of a field");
}
