// FF_COMPATIBILITY_0_5 (src/feature_flags.h): slices behave as in 0.5.1. A slice has a `cap`
// (its `len`), `Slice_X` names `Slice<X>`, and an array literal returned as a slice is copied
// to the heap. Remove this file with the flag.

struct Point {
    x: int;
}

fn weights() -> [float] {
    return [1.0, 2.0, 3.0];
}

fn first_x(points: Slice_Point) -> int {
    return points[0].x;
}

test "Slice_char builds a slice with a cap" {
    let text: char* = "hello";
    let s: [char] = Slice_char{data: text, len: (usize)5, cap: (usize)5};
    assert(s.len == 5, "len");
    assert(s.cap == 5, "cap");
    assert(s[1] == 'e', "element");
}

test "Slice_X names the slice of a primitive or a struct" {
    let arr: int[3] = [1, 2, 3];
    let ints: Slice_int = arr;
    assert(ints[2] == 3, "Slice_int");
    let same: Slice_int32_t = ints;
    assert(same.len == 3, "Slice_int32_t");

    let points: Point[1] = [Point{x: 7}];
    assert(first_x(points) == 7, "Slice_Point");
}

test "an array viewed as a slice has its length as cap" {
    let arr: int[4] = [1, 2, 3, 4];
    let s: [int] = arr;
    assert(s.cap == 4, "fixed-size array");
    let lit: [int] = [5, 6];
    assert(lit.cap == 2, "array literal");
}

test "an array literal returned as a slice is copied to the heap" {
    let w = weights();
    assert(w.len == 3 && w.cap == 3, "len and cap");
    assert(w[2] == 3.0, "element");
}
