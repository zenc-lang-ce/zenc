// closures: test_closure_many_captures
// A lambda can capture more than 32 outer variables: the capture lists are
// sized to fit them instead of having a fixed size of 32, also the list of the
// captures written between `fn[` and `]`.

test "a lambda captures 40 variables" {
    let v0 = 0;
    let v1 = 1;
    let v2 = 2;
    let v3 = 3;
    let v4 = 4;
    let v5 = 5;
    let v6 = 6;
    let v7 = 7;
    let v8 = 8;
    let v9 = 9;
    let v10 = 10;
    let v11 = 11;
    let v12 = 12;
    let v13 = 13;
    let v14 = 14;
    let v15 = 15;
    let v16 = 16;
    let v17 = 17;
    let v18 = 18;
    let v19 = 19;
    let v20 = 20;
    let v21 = 21;
    let v22 = 22;
    let v23 = 23;
    let v24 = 24;
    let v25 = 25;
    let v26 = 26;
    let v27 = 27;
    let v28 = 28;
    let v29 = 29;
    let v30 = 30;
    let v31 = 31;
    let v32 = 32;
    let v33 = 33;
    let v34 = 34;
    let v35 = 35;
    let v36 = 36;
    let v37 = 37;
    let v38 = 38;
    let v39 = 39;
    let sum = fn() -> int {
        return v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 +
               v10 + v11 + v12 + v13 + v14 + v15 + v16 + v17 + v18 + v19 +
               v20 + v21 + v22 + v23 + v24 + v25 + v26 + v27 + v28 + v29 +
               v30 + v31 + v32 + v33 + v34 + v35 + v36 + v37 + v38 + v39;
    };
    assert sum() == 780;
}

test "a lambda lists 40 captures by name" {
    let c0 = 0;
    let c1 = 1;
    let c2 = 2;
    let c3 = 3;
    let c4 = 4;
    let c5 = 5;
    let c6 = 6;
    let c7 = 7;
    let c8 = 8;
    let c9 = 9;
    let c10 = 10;
    let c11 = 11;
    let c12 = 12;
    let c13 = 13;
    let c14 = 14;
    let c15 = 15;
    let c16 = 16;
    let c17 = 17;
    let c18 = 18;
    let c19 = 19;
    let c20 = 20;
    let c21 = 21;
    let c22 = 22;
    let c23 = 23;
    let c24 = 24;
    let c25 = 25;
    let c26 = 26;
    let c27 = 27;
    let c28 = 28;
    let c29 = 29;
    let c30 = 30;
    let c31 = 31;
    let c32 = 32;
    let c33 = 33;
    let c34 = 34;
    let c35 = 35;
    let c36 = 36;
    let c37 = 37;
    let c38 = 38;
    let c39 = 39;
    let sum = fn[
        c0, c1, c2, c3, c4, c5, c6, c7, c8, c9,
        c10, c11, c12, c13, c14, c15, c16, c17, c18, c19,
        c20, c21, c22, c23, c24, c25, c26, c27, c28, c29,
        c30, c31, c32, c33, c34, c35, c36, c37, c38, c39
    ]() -> int {
        return c0 + c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 +
               c10 + c11 + c12 + c13 + c14 + c15 + c16 + c17 + c18 + c19 +
               c20 + c21 + c22 + c23 + c24 + c25 + c26 + c27 + c28 + c29 +
               c30 + c31 + c32 + c33 + c34 + c35 + c36 + c37 + c38 + c39;
    };
    assert(sum() == 780, "every capture listed by name has its value");
}
