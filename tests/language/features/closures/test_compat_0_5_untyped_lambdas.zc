// FF_COMPATIBILITY_0_5 (src/feature_flags.h): a lambda parameter needs no type where nothing at
// the lambda gives it one. The body guesses it (`x => x * 2` makes `x` an i32) or the first call
// gives it. From 0.6 such a parameter needs a type. Remove this file with the flag.
import "std/io.zc"

test "untyped_lambda_parameters" {
    let doubler = x => x * 2;
    assert(doubler(5) == 10, "doubler(5) should be 10");

    let add = (x, y) => x + y;
    assert(add(10, 20) == 30, "add(10, 20) should be 30");

    let dble = x => x * 2.0;
    assert(dble(9.0) == 18.0, "dble(9.0) should be 18.0");

    let add_three = (a, b, c) => a + b + c;
    assert(add_three(1, 2, 3) == 6, "add_three(1, 2, 3) should be 6");

    let val = 10;
    let modify = [&] x => val += x;
    modify(5);
    let sum_into = [&] (a, b) => val += (a + b);
    sum_into(2, 2);
    assert(val == 19, f"val should be 19, not {val}");
}
