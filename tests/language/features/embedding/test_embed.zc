// language/features/embedding: embedding: test_embed
import "std/io.zc"
test "test_embed" {
    println("=> Static File Analyzer");
    
    let data = embed "std.zc"; // Relative to root if run from root, or use ../../../../std.zc 
    // Actually, std.zc is always searchable from root.
    
    println("Target File: 'std.zc'");
    println(f"File Size:   {data.len} bytes");
    println("");
    
    let lines: I32 = 1;
    let words: I32 = 0;
    let sum: U64 = 0;
    let in_word: bool = 0;
    
    println("Analyzing content...");
    
    let i: int = 0;
    while (i < data.len) {
        let c: char = data.data[i];
        
        match c {
            '\n' => {
                lines++;
                in_word = 0;
            }
    
            ' ', '\t', '\r' => { 
                in_word = 0; 
            }
    
            _ => {
                if (!in_word) {
                    words++;
                    in_word = 1;
                }
            }
        }

        let b: U8 = c;
        sum = sum + b;
        
        i++;
    }
    
    println("");
    println("*** Report ***");
    println(f"Total Lines: {lines}");
    println(f"Total Words: {words}");
    
    println(f"Checksum:    0x{sum:X} (Simple Sum)"); 
    println(f"Average Byte: {sum / data.len}"); 
    
    println("");
    println("Analysis successfully completed.");
}

test "typed_embed" {
    // String
    let s = embed "tests/language/features/embedding/embed_data.txt" as string;
    // "Hello World!\n" ? No newline in my file creation? 
    // echo "Hello World!" > ... likely adds newline.
    // My previous tool 'write_to_file' wrote "Hello World!". It usually doesn't add newline unless specified?
    // Let's verify start content.
    if (s[0] != 'H') exit(101);
    
    // Fixed array
    let arr = embed "tests/language/features/embedding/embed_data.txt" as u8[5];
    if (arr[0] != 'H') exit(102);
    if (arr[4] != 'o') exit(103);
    
    // Slice
    let sl = embed "tests/language/features/embedding/embed_data.txt" as u8[];
    if (sl.len < 5) exit(104);
    if (sl.data[0] != 'H') exit(105);
    
    // Untyped regression
    let raw = embed "tests/language/features/embedding/embed_data.txt";
    if (raw.len < 5) exit(106);
    if (raw.data[0] != 'H') exit(107);
    
    println("Typed embed tests passed");
}
