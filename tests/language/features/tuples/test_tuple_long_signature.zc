        VeryLongStructureNameForAnElementOfALongTuple { v: 1 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 2 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 3 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 4 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 5 },
