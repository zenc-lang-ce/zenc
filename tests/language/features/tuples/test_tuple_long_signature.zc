        VeryLongStructureNameForAnElementOfALongTuple { v: 16 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 17 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 18 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 19 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 20 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 21 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 22 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 23 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 24 },
