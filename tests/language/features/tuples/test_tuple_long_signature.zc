        VeryLongStructureNameForAnElementOfALongTuple { v: 30 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 31 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 32 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 33 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 34 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 35 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 36 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 37 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 38 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 39 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 40 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 41 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 42 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 43 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 44 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 45 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 46 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 47 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 48 },
        VeryLongStructureNameForAnElementOfALongTuple { v: 49 }
    );
    expect_eq(last(t), 49, "the literal and the type should name the same struct");
}
