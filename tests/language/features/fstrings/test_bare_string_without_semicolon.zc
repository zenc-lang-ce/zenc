// language/features/fstrings: a bare string statement prints even without a
// trailing `;` when the next statement starts on a new line (semicolons are
// optional), for plain and interpolated strings alike.

fn main() {
    let x = 3
    "plain without semicolon"
    f"interpolated without semicolon: {x}"
    f"followed by a declaration: {x}"
    let y = x + 1
    f"y is {y}"
    "same line"; f"then {y}"
    f"without newline: {x} "..
    "last"
}
