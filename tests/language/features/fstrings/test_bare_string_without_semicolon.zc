// language/features/fstrings: a bare string statement prints even without a
// trailing `;` when the next statement starts on a new line (semicolons are
// optional), for plain and interpolated strings alike.

import "std/io.zc"
fn main() {
    let x = 3
    println("plain without semicolon")
    println(f"interpolated without semicolon: {x}")
    println(f"followed by a declaration: {x}")
    let y = x + 1
    println(f"y is {y}")
    println("same line"); println(f"then {y}")
    print(f"without newline: {x} ")
    println("last")
}
