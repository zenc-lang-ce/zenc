// language/modules: the types of a module imported one by one, or under another name, are used
// by that name: the variants of its enums build values, compare and name the cases of a `match`,
// and the program implements methods and traits for its structs. An alias imported that way is the
// type it names, in a declaration too.
import { Corner, Figure as Shape, Tile, Side, Width as Span } from "./test_modules/_selective_shapes.zc";

trait Sized {
    fn size(self) -> int;
}

impl Sized for Tile {
    fn size(self) -> int {
        return self.x * self.y;
    }
}

impl Tile {
    fn wider(self) -> Tile {
        return Tile { x: self.x + 1, y: self.y };
    }
}

fn area(f: Shape) -> int {
    match f {
        Shape::Dot => {
            return 0;
        },
        Shape::Circle(r) => {
            return r * r;
        },
        Shape::Rect(w, h) => {
            return w * h;
        },
    }
    return -1;
}

struct Frame {
    side: Side;
    span: Span;
}

fn perimeter(side: Side, span: Span) -> Side {
    return (side + span) * 2;
}

let edge: Side = 4;

test "an alias imported one by one is the type it names" {
    let frame = Frame { side: 3, span: 5 };
    assert(frame.side + frame.span == 8, "as the type of a field");
    assert(perimeter(frame.side, frame.span) == 16, "as the type of a parameter and of a result");
    assert(edge + 1 == 5, "as the type of a global");
    let local: Side = frame.side * 2;
    assert(local == 6, "as the type of a local");
    let wide: Span = frame.span + 1;
    assert(wide + (Span)2 == 8, "imported under another name, as the type of a local and of a cast");
}

test "a variant without a payload of an enum imported one by one" {
    let corner: Corner = Corner::Bottom;
    assert(corner == Corner::Bottom, "a comparison with a variant");
    let number = 0;
    match corner {
        Corner::Top => {
            number = 1;
        },
        Corner::Bottom => {
            number = 2;
        },
    }
    assert(number == 2, "a match on the enum");
}

test "the variants of an enum imported under another name" {
    assert(area(Shape::Dot) == 0, "a variant without a payload as an argument");
    assert(area(Shape::Circle(3)) == 9, "a variant with a payload");
    assert(area(Shape::Rect(2, 5)) == 10, "a variant with two values");
}

test "the program implements methods and traits for a struct imported one by one" {
    let tile = Tile { x: 2, y: 3 };
    assert(tile.size() == 6, "a trait method");
    assert(tile.wider().x == 3, "a method of an `impl` in the program");
}
