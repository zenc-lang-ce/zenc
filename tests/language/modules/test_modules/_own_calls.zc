// A module that calls its own functions: from a function, from a method, before the
// function is declared, and through a function value. A local of the same name hides them.

fn twice(x: int) -> int {
    return x * 2;
}

fn quadruple(x: int) -> int {
    return twice(twice(x));
}

fn plus_one_later(x: int) -> int {
    return add_one(x);
}

fn add_one(x: int) -> int {
    return x + 1;
}

fn through_value(x: int) -> int {
    let f = twice;
    return f(x);
}

fn local_hides(x: int) -> int {
    let twice = x + 1;
    return twice;
}

struct Counter {
    value: int;
}

impl Counter {
    fn new(value: int) -> Counter {
        return Counter { value: value };
    }

    fn doubled(self) -> int {
        return twice(self.value);
    }
}
