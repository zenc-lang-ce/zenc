// A module that imports by name what it uses (test_module_imports_inside.zc).
import { Corner, Figure as Shape, Tile, Side } from "./_selective_shapes.zc";
import { make_pair, sum_pair as total } from "./_wildcard_functions.zc";

struct Board {
    tile: Tile;
    corner: Corner;
    side: Side;
}

fn area(shape: Shape) -> int {
    match shape {
        Shape::Dot => {
            return 0;
        },
        Shape::Circle(r) => {
            return r * r;
        },
        Shape::Rect(w, h) => {
            return w * h;
        },
    }
    return -1;
}

fn board_total() -> int {
    let board = Board { tile: Tile { x: 2, y: 3 }, corner: Corner::Bottom, side: 4 };
    let empty = Tile {};
    return board.tile.x + board.tile.y + (int)board.corner + board.side + empty.x;
}

fn shapes_total() -> int {
    return area(Shape::Circle(2)) + area(Shape::Rect(2, 3)) + total(make_pair());
}
