// language/generics: test_impl_trait_before_generic_type
// A trait impl written before the generic struct or enum it is for, naming the type without its
// parameter (`impl Show for Cell`), is a template like one written after it: each instance gets
// the methods, an instance named before both included.

fn shown(c: Cell<int>) -> int {
    return c.show();
}

trait Show {
    fn show(self) -> int;
}

impl Show for Cell {
    fn show(self) -> int {
        return (int)self.v + 1;
    }
}

struct Cell<T> {
    v: T;
}

impl Show for Maybe {
    fn show(self) -> int {
        return 3;
    }
}

enum Maybe<T> {
    Some(T),
    Nothing
}

test "a trait impl before its generic struct" {
    let c = Cell<int> { v: 4 };
    let d = Cell<i64> { v: 9 };
    expect_eq(shown(c), 5, "Cell<int> should have show, from an instance named before the impl");
    expect_eq(d.show(), 10, "Cell<i64> should have show");
}

test "a trait impl before its generic enum" {
    let m = Maybe<int>::Some(2);
    expect_eq(m.show(), 3, "Maybe<int> should have show");
}

static let drops = 0;

impl Drop for Holder {
    fn drop(self) {
        drops = drops + 1;
    }
}

struct Holder<T> {
    v: T;
}

test "an impl Drop before its generic struct" {
    {
        let h = Holder<int> { v: 1 };
        expect_eq(h.v, 1, "Holder<int> should keep its value");
    }
    expect_eq(drops, 1, "Holder<int> should be dropped once at the end of its block");
}
