
import "./core.zc"
import "./hash.zc"
import "./option.zc"
import "./mem.zc"

// Pure Zen-C string hash using FNV-1a algorithm
fn _map_hash_str(str: const char*) -> usize {
    let hash = hash_get_seed();
    let i: usize = 0;
    
    while (str[i] != 0) {
        // Cast char to u8 for unsigned byte value
        let b: u8 = (u8)str[i];
        hash = hash_combine(hash, (usize)b);
        i = i + 1;
    }
    
    return hash;
}

struct Map<V> {
    keys: char**;
    vals: V*;
    occupied: bool*;
    len: usize;
    cap: usize;
}

struct MapEntry<V> {
    key: char*;
    val: V;
}

struct MapIter<V> {
    keys: char**;
    vals: V*;
    occupied: bool*;
    cap: usize;
    idx: usize;
}

struct MapIterResult<V> {
    entry: MapEntry<V>;
    has_val: bool;
}

impl MapIterResult<V> {
    fn is_none(self) -> bool {
        return !self.has_val;
    }
    
    fn unwrap(self) -> MapEntry<V> {
        if (!self.has_val) {
             panic("Map iterator unwrap on None");
        }
        return self.entry;
    }
}

impl MapIter<V> {
    /// Yields the next entry.
    fn next(self) -> MapIterResult<V> {
        while self.idx < self.cap {
            let i = self.idx;
            self.idx = self.idx + 1;
            
            if (self.occupied[i]) {
                let entry = MapEntry<V> {
                    key: self.keys[i],
                    val: self.vals[i]
                };
                return MapIterResult<V> {
                    entry: entry,
                    has_val: true
                };
            }
        }
        // Empty entry for None (zero-initialized to avoid reading uninitialized data)
        let empty: MapEntry<V>;
        memset(&empty, 0, sizeof(MapEntry<V>));
        return MapIterResult<V> { entry: empty, has_val: false };
    }
}

impl Map<V> {
    /// Creates a new, empty Map.
    fn new() -> Map<V> {
        return Map<V> { keys: 0, vals: 0, occupied: 0, len: 0, cap: 0 };
    }

    fn _resize(self, new_cap: usize) {
        let old_keys = self.keys;
        let old_vals = self.vals;
        let old_occupied = self.occupied;
        let old_cap = self.cap;

        self.cap = new_cap;
        self.keys = alloc_n<char*>(new_cap);
        self.vals = alloc_n<V>(new_cap);
        self.occupied = alloc_n<bool>(new_cap);
        // Manual zeroing as alloc_n doesn't zero in non-misra mode
        memset(self.keys, 0, new_cap * sizeof(char*));
        memset(self.vals, 0, new_cap * sizeof(V));
        memset(self.occupied, 0, new_cap * sizeof(bool));
        self.len = 0;

        // Each key moves to the new table with the string the Map already owns.
        for (let i: usize = 0; i < old_cap; i = i + 1) {
            if (old_occupied[i]) {
                let idx = self._find_slot(old_keys[i]);
                self.keys[idx] = old_keys[i];
                self.vals[idx] = old_vals[i];
                self.occupied[idx] = true;
                self.len = self.len + 1;
            }
        }
        
        // Free old arrays (use explicit braces to avoid parser bug)
        if (old_keys != NULL) { dealloc<char*>(old_keys); }
        if (old_vals != NULL) { dealloc<V>(old_vals); }
        if (old_occupied != NULL) { dealloc<bool>(old_occupied); }
    }

    // The slot of `key`, or the empty slot that ends its chain. The table always has an
    // empty slot: put grows it before it is three quarters full.
    fn _find_slot(self, key: char*) -> usize {
        let idx = _map_hash_str(key) % self.cap;
        while (self.occupied[idx] && strcmp(self.keys[idx], key) != 0) {
            idx = (idx + 1) % self.cap;
        }
        return idx;
    }

    /// Inserts or overwrites the value for `key`.
    fn put(self, key: char*, val: V) {
        if (self.len >= self.cap * 0.75) {
            let new_cap = self.cap * 2;
            if (new_cap < 8) {
                new_cap = 8;
            }
            self._resize(new_cap);
        }

        let idx = self._find_slot(key);
        if (self.occupied[idx]) {
            self.vals[idx] = val;
            return;
        }

        self.keys[idx] = strdup(key);
        self.vals[idx] = val;
        self.occupied[idx] = true;
        self.len = self.len + 1;
    }

    /// Returns the value for `key`, or `None`.
    fn get(self, key: char*) -> Option<V> {
        if (self.cap == 0) {
            return Option<V>::None();
        }

        let idx = self._find_slot(key);
        if (self.occupied[idx]) {
            return Option<V>::Some(self.vals[idx]);
        }
        return Option<V>::None();
    }
    
    /// Returns whether `key` exists.
    fn contains(self, key: char*) -> bool {
        let opt: Option<V> = self.get(key);
        return opt.is_some();
    }
    
    /// Removes `key`, if present.
    fn remove(self, key: char*) {
        if (self.cap == 0) {
            return;
        }

        let hole = self._find_slot(key);
        if (!self.occupied[hole]) {
            return;
        }
        dealloc<char>(self.keys[hole]);
        self.len = self.len - 1;

        // Close the hole: move back each entry of the chain that a search would no longer
        // reach, so that every chain ends at an empty slot and no slot is marked as removed.
        let idx = hole;
        while (true) {
            idx = (idx + 1) % self.cap;
            if (!self.occupied[idx]) {
                break;
            }
            // The entry stays if its home slot is after the hole and up to its own slot.
            let home = _map_hash_str(self.keys[idx]) % self.cap;
            let stays = false;
            if (hole <= idx) {
                stays = hole < home && home <= idx;
            } else {
                stays = hole < home || home <= idx;
            }
            if (!stays) {
                self.keys[hole] = self.keys[idx];
                self.vals[hole] = self.vals[idx];
                hole = idx;
            }
        }
        self.keys[hole] = NULL;
        self.occupied[hole] = false;
    }
    
    /// Returns the number of entries.
    fn length(self) -> usize {
        return self.len;
    }
    
    /// Returns whether the Map is empty.
    fn is_empty(self) -> bool {
        return self.len == 0;
    }
    
    /// Frees all entries and the backing storage.
    fn free(self) {
        if (self.keys) {
            for (let i: usize = 0; i < self.cap; i = i + 1) {
                if (self.occupied[i]) {
                    dealloc<char>(self.keys[i]);
                }
            }
            dealloc<char*>(self.keys);
            dealloc<V>(self.vals);
            dealloc<bool>(self.occupied);
        }
        self.keys = 0;
        self.vals = 0;
        self.occupied = 0;
        self.len = 0;
        self.cap = 0;
    }
    
    /// Returns the current table capacity.
    fn capacity(self) -> usize {
        return self.cap;
    }
    
    /// Returns whether slot `idx` holds an entry.
    fn is_slot_occupied(self, idx: usize) -> bool {
        if (idx >= self.cap) {
            return false;
        }
        return self.occupied[idx];
    }
    
    /// Returns the key at slot `idx`.
    fn key_at(self, idx: usize) -> char* {
        if (idx >= self.cap || !self.occupied[idx]) {
            return NULL;
        }
        return self.keys[idx];
    }
    
    /// Returns the value at slot `idx`; panics if `idx` is not below `capacity()`.
    fn val_at(self, idx: usize) -> V {
        if (idx >= self.cap) {
            panic("Index out of bounds");
        }
        return self.vals[idx];
    }

    /// Returns an iterator over the entries.
    fn iterator(self) -> MapIter<V> {
        return MapIter<V> {
            keys: self.keys,
            vals: self.vals,
            occupied: self.occupied,
            cap: self.cap,
            idx: 0
        };
    }
}

impl Drop for Map {
    fn drop(self) {
        self.free();
    }
}
